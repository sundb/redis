{
    "ZMOVEMEMBER": {
        "summary": "Moves the given members from one sorted set to another, keeping their scores, and returns them. Deletes the source sorted set if it becomes empty.",
        "complexity": "O(K*log(N)+K*log(M)) where N and M are the number of members in the source and destination sorted sets, and K is the number of members given.",
        "group": "sorted_set",
        "since": "8.12.0",
        "arity": -6,
        "function": "zmovememberCommand",
        "command_flags": [
            "WRITE",
            "DENYOOM"
        ],
        "acl_categories": [
            "SORTEDSET"
        ],
        "key_specs": [
            {
                "flags": [
                    "RW",
                    "ACCESS",
                    "DELETE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            },
            {
                "flags": [
                    "RW",
                    "UPDATE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 2
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "reply_schema": {
            "oneOf": [
                {
                    "description": "No member was moved: the source doesn't exist, has none of the given members, none of them satisfies NX or XX, or the source and the destination are the same key.",
                    "type": "null"
                },
                {
                    "description": "The moved members with their scores, in the order they were given. Members the source doesn't have, and those left out by NX or XX, are skipped.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": [
                            {
                                "type": "string",
                                "description": "Name of the member."
                            },
                            {
                                "type": "number",
                                "description": "Score."
                            }
                        ]
                    }
                }
            ]
        },
        "arguments": [
            {
                "name": "source",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "destination",
                "type": "key",
                "key_spec_index": 1
            },
            {
                "name": "condition",
                "type": "oneof",
                "optional": true,
                "arguments": [
                    {
                        "name": "nx",
                        "type": "pure-token",
                        "token": "NX"
                    },
                    {
                        "name": "xx",
                        "type": "pure-token",
                        "token": "XX"
                    }
                ]
            },
            {
                "name": "members",
                "type": "block",
                "token": "MEMBERS",
                "arguments": [
                    {
                        "name": "num-members",
                        "type": "integer"
                    },
                    {
                        "name": "member",
                        "type": "string",
                        "multiple": true
                    }
                ]
            }
        ]
    }
}
